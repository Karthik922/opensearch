{
  "info": {
    "name": "NestJS OpenSearch API",
    "description": "CRUD + search API for products stored in OpenSearch.\n\n**Run order:** start with `0. Setup → Seed sample data (bulk)`, then run any request. Or run the whole collection with the Collection Runner. Every request has tests.\n\nSet the `baseUrl` collection variable to where the API runs (default `http://localhost:3000`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "createdId",
      "value": ""
    },
    {
      "key": "cursor",
      "value": ""
    },
    {
      "key": "lastPrice",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"OpenSearch is reachable\", () => {",
                  "  const s = pm.response.json().opensearch.status;",
                  "  pm.expect([\"green\", \"yellow\"]).to.include(s);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Seed sample data (bulk)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"No bulk errors\", () => pm.expect(pm.response.json().errors).to.be.false);",
                  "pm.test(\"15 items indexed\", () => pm.expect(pm.response.json().items).to.have.length(15));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"p-1001\",\n    \"name\": \"Wireless Mouse\",\n    \"description\": \"Ergonomic 2.4GHz wireless mouse with silent clicks and USB receiver\",\n    \"category\": \"electronics\",\n    \"tags\": [\n      \"computer\",\n      \"accessories\"\n    ],\n    \"price\": 19.99,\n    \"stock\": 150\n  },\n  {\n    \"id\": \"p-1002\",\n    \"name\": \"Mechanical Keyboard\",\n    \"description\": \"RGB backlit mechanical keyboard with blue switches\",\n    \"category\": \"electronics\",\n    \"tags\": [\n      \"computer\",\n      \"gaming\"\n    ],\n    \"price\": 79.5,\n    \"stock\": 40\n  },\n  {\n    \"id\": \"p-1003\",\n    \"name\": \"Gaming Headset\",\n    \"description\": \"Surround sound headset with noise cancelling microphone\",\n    \"category\": \"electronics\",\n    \"tags\": [\n      \"gaming\",\n      \"audio\"\n    ],\n    \"price\": 59,\n    \"stock\": 0\n  },\n  {\n    \"id\": \"p-1004\",\n    \"name\": \"27 inch 4K Monitor\",\n    \"description\": \"IPS display with HDR10 and USB-C power delivery\",\n    \"category\": \"electronics\",\n    \"tags\": [\n      \"computer\",\n      \"display\"\n    ],\n    \"price\": 329,\n    \"stock\": 12\n  },\n  {\n    \"id\": \"p-1005\",\n    \"name\": \"Bluetooth Speaker\",\n    \"description\": \"Portable waterproof speaker with 20 hour battery\",\n    \"category\": \"electronics\",\n    \"tags\": [\n      \"audio\",\n      \"outdoor\"\n    ],\n    \"price\": 45,\n    \"stock\": 75\n  },\n  {\n    \"id\": \"p-1006\",\n    \"name\": \"USB-C Hub\",\n    \"description\": \"7-in-1 hub with HDMI, SD card reader and 100W charging\",\n    \"category\": \"electronics\",\n    \"tags\": [\n      \"computer\",\n      \"accessories\"\n    ],\n    \"price\": 34.9,\n    \"stock\": 0\n  },\n  {\n    \"id\": \"p-2001\",\n    \"name\": \"Ceramic Coffee Mug\",\n    \"description\": \"Dishwasher safe ceramic mug, 350ml\",\n    \"category\": \"kitchen\",\n    \"tags\": [\n      \"home\",\n      \"coffee\"\n    ],\n    \"price\": 8.99,\n    \"stock\": 300\n  },\n  {\n    \"id\": \"p-2002\",\n    \"name\": \"French Press\",\n    \"description\": \"Stainless steel coffee maker, 1 litre\",\n    \"category\": \"kitchen\",\n    \"tags\": [\n      \"coffee\"\n    ],\n    \"price\": 27.5,\n    \"stock\": 60\n  },\n  {\n    \"id\": \"p-2003\",\n    \"name\": \"Chef Knife\",\n    \"description\": \"Japanese steel 8 inch chef knife with wooden handle\",\n    \"category\": \"kitchen\",\n    \"tags\": [\n      \"cooking\"\n    ],\n    \"price\": 64,\n    \"stock\": 18\n  },\n  {\n    \"id\": \"p-3001\",\n    \"name\": \"Clean Code\",\n    \"description\": \"A handbook of agile software craftsmanship by Robert C. Martin\",\n    \"category\": \"books\",\n    \"tags\": [\n      \"programming\",\n      \"bestseller\"\n    ],\n    \"price\": 32.99,\n    \"stock\": 25\n  },\n  {\n    \"id\": \"p-3002\",\n    \"name\": \"Designing Data-Intensive Applications\",\n    \"description\": \"Reliable, scalable and maintainable systems, databases and search engines\",\n    \"category\": \"books\",\n    \"tags\": [\n      \"programming\",\n      \"databases\"\n    ],\n    \"price\": 44.5,\n    \"stock\": 9\n  },\n  {\n    \"id\": \"p-4001\",\n    \"name\": \"Running Shoes\",\n    \"description\": \"Lightweight breathable running shoes for road and trail\",\n    \"category\": \"sports\",\n    \"tags\": [\n      \"running\",\n      \"outdoor\"\n    ],\n    \"price\": 89.99,\n    \"stock\": 33\n  },\n  {\n    \"id\": \"p-4002\",\n    \"name\": \"Yoga Mat\",\n    \"description\": \"Non-slip 6mm yoga mat with carry strap\",\n    \"category\": \"sports\",\n    \"tags\": [\n      \"fitness\",\n      \"yoga\"\n    ],\n    \"price\": 24,\n    \"stock\": 120\n  },\n  {\n    \"id\": \"p-4003\",\n    \"name\": \"Adjustable Dumbbells\",\n    \"description\": \"Pair of adjustable dumbbells from 2 to 24 kg\",\n    \"category\": \"sports\",\n    \"tags\": [\n      \"fitness\",\n      \"gym\"\n    ],\n    \"price\": 249,\n    \"stock\": 0\n  },\n  {\n    \"id\": \"p-5001\",\n    \"name\": \"Cotton T-Shirt\",\n    \"description\": \"Organic cotton crew neck t-shirt, regular fit\",\n    \"category\": \"fashion\",\n    \"tags\": [\n      \"clothing\",\n      \"summer\"\n    ],\n    \"price\": 15,\n    \"stock\": 500\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "bulk"
              ]
            },
            "description": "Loads 15 sample products. Safe to run again: existing ids are overwritten."
          }
        }
      ]
    },
    {
      "name": "1. Create",
      "item": [
        {
          "name": "Create product (auto id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Has generated id\", () => pm.expect(body.id).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"inStock computed\", () => pm.expect(body.inStock).to.be.true);",
                  "pm.collectionVariables.set(\"createdId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart Watch\",\n  \"description\": \"Fitness tracker with heart rate monitor and GPS\",\n  \"category\": \"electronics\",\n  \"tags\": [\n    \"wearable\",\n    \"fitness\"\n  ],\n  \"price\": 149,\n  \"stock\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "No `id` sent, so a UUID is generated. The id is saved to the `createdId` variable for the following requests."
          }
        },
        {
          "name": "Create product (custom id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Out of stock\", () => pm.expect(pm.response.json().inStock).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"demo-{{$timestamp}}\",\n  \"name\": \"Desk Lamp\",\n  \"description\": \"LED desk lamp with dimmer and USB port\",\n  \"category\": \"home\",\n  \"tags\": [\n    \"lighting\"\n  ],\n  \"price\": 22.5,\n  \"stock\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Your own id. `{{$timestamp}}` keeps it unique on every run."
          }
        },
        {
          "name": "Create duplicate id → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"p-1001\",\n  \"name\": \"Duplicate\",\n  \"category\": \"electronics\",\n  \"price\": 1,\n  \"stock\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Create invalid body → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Lists validation messages\", () => pm.expect(pm.response.json().message).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": -5,\n  \"color\": \"red\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Empty name, missing category/stock, negative price and an unknown field."
          }
        }
      ]
    },
